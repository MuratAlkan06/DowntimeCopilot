# AWS credentials template
# ------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Paste your real keys into .env (NEVER into this file).
# 3. .env is gitignored — do not commit it or share keys in chat apps.
# Prefer short-lived session credentials (AWS_SESSION_TOKEN) over long-lived keys.
# Lines use `export` so `source .env` passes them to `make` and its children.

export AWS_DEFAULT_REGION=us-east-1
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_SESSION_TOKEN=

# Published Bedrock guardrail (docs/decisions.md, S3). With both set and DRY_RUN=0, every AI
# output goes through ApplyGuardrail on that version; leave either empty for the checker fallback.
# Get the values from the team, never commit them here.
export GUARDRAIL_ID=
export GUARDRAIL_VERSION=

# Verbal-order audio bucket for Transcribe (docs/decisions.md S9). `python tools/audio_bucket.py setup`
# generates downtime-copilot-audio-<random suffix> once and appends it to .env. Leave it empty here.
export AUDIO_BUCKET=

# DynamoDB sync mirror table (docs/decisions.md S10). `python tools/sync_table.py setup` generates
# downtime-copilot-sync-<random suffix> once and appends it to .env. Empty: the local JSONL fallback.
export SYNC_TABLE=

# Mock mode: canned Bedrock, Textract and Transcribe responses with the same shapes;
# no credentials or network needed. Set to 0 once real keys are pasted above.
export DRY_RUN=1

# Optional: vitals normal ranges for out_of_range flags (docs/decisions.md, S4). Inclusive "low,high",
# e.g. VITAL_RANGE_SPO2="90,100". Unset = policy 3.4 defaults in app/config.py.
# export VITAL_RANGE_SPO2=
