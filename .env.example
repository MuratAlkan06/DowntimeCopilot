# AWS environment template
# ------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Owner's account: run `make infra-env`. It fills .env from the Terraform outputs --
#    AWS_PROFILE=downtime-runtime plus the resource names below -- and strips any static
#    AWS key lines (a static key in the environment takes precedence over a profile).
# 3. Anyone else: paste short-lived session credentials (AWS_SESSION_TOKEN) into .env
#    (NEVER into this file) and leave AWS_PROFILE empty.
# .env is gitignored -- do not commit it or share keys in chat apps.
# Lines use `export` so `source .env` passes them to `make` and its children.

export AWS_DEFAULT_REGION=us-east-1

# Owner flow: the deploy user assumes downtime-copilot-runtime (infra/, docs/decisions.md #43).
# `make infra-env` sets this. Leave it empty when pasting session credentials below.
export AWS_PROFILE=

# Fallback for accounts without the Terraform stack: short-lived session credentials.
# Leave all three empty when AWS_PROFILE is set -- a static key would override the profile.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_SESSION_TOKEN=

# Published Bedrock guardrail (docs/decisions.md, S3 and #43). With both set and DRY_RUN=0, every AI
# output goes through ApplyGuardrail on that version; leave either empty for the checker fallback.
# `make infra-env` fills both from the Terraform outputs; never commit the values here.
export GUARDRAIL_ID=
export GUARDRAIL_VERSION=

# Verbal-order audio bucket for Transcribe (docs/decisions.md S9). Defined in infra/ and filled by
# `make infra-env` (downtime-copilot-audio-<random suffix>). Leave it empty here.
export AUDIO_BUCKET=

# DynamoDB sync mirror table (docs/decisions.md S10). Defined in infra/ and filled by
# `make infra-env` (downtime-copilot-sync-<random suffix>). Empty: the local JSONL fallback.
export SYNC_TABLE=

# Mock mode: canned Bedrock, Textract and Transcribe responses with the same shapes;
# no credentials or network needed. Set to 0 once AWS_PROFILE or real keys are set above.
export DRY_RUN=1

# Optional: vitals normal ranges for out_of_range flags (docs/decisions.md, S4). Inclusive "low,high",
# e.g. VITAL_RANGE_SPO2="90,100". Unset = policy 3.4 defaults in app/config.py.
# export VITAL_RANGE_SPO2=
