# AWS credentials template
# ------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Paste your real keys into .env (NEVER into this file).
# 3. .env is gitignored — do not commit it or share keys in chat apps.
# Prefer short-lived session credentials (AWS_SESSION_TOKEN) over long-lived keys.

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
