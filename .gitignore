# --- Secrets / environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
service-account*.json

# --- Node ---
node_modules/
.npm/
.pnpm-store/
.yarn/
*.tsbuildinfo
.eslintcache

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Build / output ---
dist/
build/
out/
dev-dist/
.next/
.nuxt/
.turbo/
.cache/
coverage/
*.local

# --- Logs / temp ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- IDE / tooling ---
.idea/
.vscode/
!.vscode/extensions.json
*.code-workspace
.super.engineering/
.superconductor/
.claude/

# --- Project-local (never commit) ---
# Probe is distributed by DM only; tools/guard.sh fails if it is ever tracked.
tools/bedrock_probe.py
*.sqlite
*.db
# Photographed eval forms stay local (may contain handwriting of real people).
evals/fixtures/*.jpg
evals/fixtures/*.jpeg
evals/fixtures/*.png
# Eval run bundles (scratch). Scrubbed baselines are committed under evals/baseline/; the newest generates RESULTS.md.
evals/runs/
# Terraform (infra/). State and variable files stay local: state holds account IDs and ARNs, terraform.tfvars
# holds the budget email. .terraform.lock.hcl IS committed. tools/guard.sh check 5 enforces this.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
infra/backend.hcl

# Durability harness runs (make durability)
durability-runs/

# Demo video recordings and encodes (make demo-video). Run outputs, GIFs included, live in tools/demo_video/out/,
# which the out/ rule above ignores. GIFs are not ignored repo-wide, so the README's docs/demo.gif can be committed.
*.mp4
*.webm
