# Downtime Copilot. See README "Running it".
# Credentials: `source .env` first (export lines). Mock mode: `DRY_RUN=1 make dev`.

VENV    := .venv
PY      := $(VENV)/bin/python
# DEPS is the input list for `make lock`; `make setup` and CI install the pinned LOCK.
DEPS    := boto3 fastapi uvicorn pydantic pytest httpx python-multipart pillow
LOCK    := requirements.lock
LOCK_PY ?= python3.12
PROBE   := tools/bedrock_probe.py
SIM_APP ?= simulator.main:app
API_APP ?= app.main:app
APP_PORT ?= 8000
SIM_PORT ?= 8001
SIM_URL ?= http://localhost:$(SIM_PORT)
APP_URL ?= http://localhost:$(APP_PORT)/?phase=before
TF      ?= terraform
export APP_PORT SIM_PORT SIM_URL

.PHONY: setup lock probe schemas forms dev demo test evals results guard export-audit e2e infra-fmt infra-validate infra-env durability demo-video-setup demo-video demo-video-dryrun demo-video-post

setup:  ## venv + pinned dependencies from requirements.lock
	python3 -m venv $(VENV)
	$(PY) -m pip install -q --upgrade pip
	$(PY) -m pip install -q -r $(LOCK)

lock:  ## regenerate requirements.lock from DEPS in a fresh throwaway venv. MUST run under Python 3.12 (LOCK_PY, default python3.12; refuses otherwise)
	@$(LOCK_PY) -c 'import sys; sys.exit(0 if sys.version_info[:2] == (3, 12) else "make lock: $(LOCK_PY) is not Python 3.12; the lock must be generated under 3.12")'
	@tmp=$$(mktemp -d) && trap 'rm -rf "$$tmp"' EXIT && \
	$(LOCK_PY) -m venv "$$tmp/venv" && \
	"$$tmp/venv/bin/python" -m pip install -q --upgrade pip && \
	"$$tmp/venv/bin/python" -m pip install -q $(DEPS) && \
	{ printf '%s\n' \
		'# Pinned install set for `make setup` and CI. Do not hand-edit.' \
		'# Generated by Python 3.12 via `python3.12 -m venv && pip install <DEPS> && pip freeze`,' \
		'# DEPS (Makefile) = $(DEPS)' \
		'# Regenerate with `make lock` (must run under Python 3.12).' && \
	  "$$tmp/venv/bin/python" -m pip freeze; } > "$$tmp/lock" && \
	mv "$$tmp/lock" $(LOCK) && echo "Wrote $(LOCK)"

probe:  ## what this AWS account allows; decides fallbacks (docs/decisions.md)
	@if [ ! -f $(PROBE) ]; then \
		echo "$(PROBE) not found: probe is distributed by DM, not in git. Save it to $(PROBE) (it is git-ignored)."; \
		exit 1; \
	fi
	$(PY) $(PROBE) --extras

schemas:  ## re-export contracts/schema/*.json after a contract change
	$(PY) -m contracts.export_schemas

forms:  ## regenerate printable form templates, layout maps and seeded fixtures (data/forms/)
	$(PY) tools/form_fixtures.py

dev:  ## simulator on :$(SIM_PORT) (default 8001), app on :$(APP_PORT) (default 8000); Ctrl-C stops both
	@$(PY) -m uvicorn $(SIM_APP) --port $(SIM_PORT) --reload & sim=$$!; \
	$(PY) -m uvicorn $(API_APP) --port $(APP_PORT) --reload & api=$$!; \
	trap 'kill $$sim $$api 2>/dev/null' INT TERM EXIT; \
	wait

demo:  ## clean store + 12 patients at "Before" with a healthy EHR; prints the URL (DEMO_OPEN=1 also opens it). Needs `make dev`
	$(PY) -m simulator.seed --fresh
	@echo "Demo ready: $(APP_URL)"
	@if [ "$(DEMO_OPEN)" = "1" ]; then \
		if command -v open >/dev/null; then open "$(APP_URL)"; else xdg-open "$(APP_URL)" || true; fi; \
	fi

export-audit:  ## audit log -> exports/ in AUDIO_BUCKET (local file in DRY_RUN). AT=2026-10-24T09:00:00Z re-names one export (idempotent). Needs `make dev`
	@curl -fsS -X POST "http://localhost:$(APP_PORT)/sync/export$(if $(AT),?at=$(AT))"; echo

test:  ## unit tests
	$(PY) -m pytest -q

e2e:  ## the demo script end to end through the API, mock mode (tests/test_e2e.py)
	DRY_RUN=1 $(PY) -m pytest -q tests/test_e2e.py

evals:  ## ONE live run of evals/manifest.json -> evals/runs/<run-id>/ + RESULTS.md. Needs `source .env`, DRY_RUN=0, a fresh scratch STORE_PATH and the simulator on SIM_PORT (refuses otherwise)
	$(PY) -m evals.run

results:  ## regenerate RESULTS.md from the newest committed bundle (evals/baseline/<run-id>/ + evals/NOTES.md); pure, no network. BUNDLE=<dir> overrides
	$(PY) -m evals.report $(BUNDLE)

CYCLES ?= 25
SEED   ?= auto
DURABILITY_STAMP := $(shell date -u +%Y%m%dT%H%M%SZ)
DURABILITY_DIR ?= durability-runs/$(DURABILITY_STAMP)

durability:  ## fault-injection durability harness (docs/durability.md): server cycles (DynamoDB Local via DDB_LOCAL_DIR + java, else SKIP), then node queue cycles, then the report. CYCLES=25 SEED=auto
	PYTHONPATH=. $(PY) -m tools.durability.harness --run-dir $(DURABILITY_DIR) --cycles $(CYCLES) --seed $(SEED)
	PYTHONPATH=. $(PY) -m tools.durability.queue_cycles --run-dir $(DURABILITY_DIR) --cycles $(CYCLES)
	PYTHONPATH=. $(PY) -m tools.durability.report $(DURABILITY_DIR)

# Demo video (tools/demo_video, docs/decisions.md): Playwright records DEMO.md's 90-second cut against its own sim +
# app on VIDEO_SIM_PORT / VIDEO_APP_PORT (a scratch store; refuses busy ports), then ffmpeg cuts, captions and encodes.
VIDEO_DIR      := tools/demo_video
NODE           ?= node
NPM            ?= npm
FFMPEG         ?= ffmpeg
FFPROBE        ?= ffprobe
VIDEO_APP_PORT ?= 8800
VIDEO_SIM_PORT ?= 8801
export VIDEO_APP_PORT VIDEO_SIM_PORT FFMPEG FFPROBE
VIDEO_DEPS   = @test -d $(VIDEO_DIR)/node_modules/playwright || { echo "demo video: node dependencies missing; run \`make demo-video-setup\` (npm ci, then npx playwright install chromium)"; exit 1; }
FFMPEG_CHECK = @command -v $(FFMPEG) >/dev/null 2>&1 && command -v $(FFPROBE) >/dev/null 2>&1 || { echo "demo video: $(FFMPEG) / $(FFPROBE) not found. Install them with \`brew install ffmpeg\` (or set FFMPEG=... FFPROBE=...)."; exit 1; }

demo-video-setup:  ## demo video node deps: npm ci --ignore-scripts (Playwright pinned in tools/demo_video/package-lock.json; no install scripts run), then npx playwright install chromium
	cd $(VIDEO_DIR) && $(NPM) ci --ignore-scripts && npx playwright install chromium

demo-video:  ## LIVE demo video, real AWS calls. Needs `source .env` (AWS_PROFILE) and ffmpeg (fails fast without either) -> tools/demo_video/out/<run>/demo.mp4 + demo.gif, gated 85-95 s, <=10 MB, GIF <=5 MB
	@if [ -z "$$AWS_PROFILE" ]; then echo "demo-video: AWS_PROFILE is unset. \`source .env\` first (make infra-env writes it); development footage: make demo-video-dryrun"; exit 1; fi
	$(FFMPEG_CHECK)
	$(VIDEO_DEPS)
	cd $(VIDEO_DIR) && PY=$(abspath $(PY)) $(NODE) record.mjs --mode live
	cd $(VIDEO_DIR) && $(NODE) postprocess.mjs --latest live

demo-video-dryrun:  ## the same pipeline with DRY_RUN=1 (no AWS): DRY RUN on every frame, never a deliverable. VIDEO_ARGS="--shots --simulate-latency 4" for development
	$(VIDEO_DEPS)
	cd $(VIDEO_DIR) && DRY_RUN=1 PY=$(abspath $(PY)) $(NODE) record.mjs --mode dry_run $(VIDEO_ARGS)
	cd $(VIDEO_DIR) && $(NODE) postprocess.mjs --latest dry_run

demo-video-post:  ## only the ffmpeg stage, on a recording: RUN=tools/demo_video/out/<run> (default: the latest live one)
	$(FFMPEG_CHECK)
	cd $(VIDEO_DIR) && $(NODE) postprocess.mjs $(if $(RUN),--run $(abspath $(RUN)),--latest live)

guard:  ## secret / probe guard (run before every commit)
	bash tools/guard.sh

infra-fmt:  ## rewrite infra/**/*.tf in canonical format (CI runs the -check form, see infra-validate)
	$(TF) fmt -recursive infra

infra-validate:  ## the CI "Terraform validate" job locally: fmt -check, then init -backend=false + validate in infra/bootstrap and infra. No AWS calls, no state
	$(TF) fmt -check -recursive infra
	@for d in infra/bootstrap infra; do \
		echo "== $$d"; \
		$(TF) -chdir=$$d init -backend=false -input=false >/dev/null && $(TF) -chdir=$$d validate || exit 1; \
	done

infra-env:  ## terraform outputs (infra/, profile downtime-admin) -> .env: AWS_PROFILE=downtime-runtime + resource names; drops static keys. Prints names, never values
	TF=$(TF) $(PY) tools/env_sync.py
